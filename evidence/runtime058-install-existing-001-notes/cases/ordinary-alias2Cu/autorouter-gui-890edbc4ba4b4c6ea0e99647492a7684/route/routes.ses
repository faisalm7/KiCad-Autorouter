(session task
  (base_design task)
  (placement
    (resolution um 10)
    (component "owned1007_transport_terminal"
      (place J1 120000 -100000 front 0)
      (place J2 260000 -100000 front 0)
      (place J3 120000 -160000 front 0)
      (place J4 260000 -160000 front 0)
      (place J5 120000 -240000 front 0)
      (place J6 260000 -240000 front 0)
    )
    (component "owned_task_copper_mark"
      (place "KAR_PD_A_6a81484ccb6355d4905f1ab750f66b74" 100000 -280000 front 0)
      (place "KAR_PD_A_c1d2dc5631ac54df9b31a3aeac1195e8" 130000 -280000 front 0)
    )
  )
  (was_is
  )
  (routes 
    (resolution um 10)
    (parser
      (host_cad "KiCad's Pcbnew")
      (host_version "10.0.7")
    )
    (library_out 
      (padstack "Via[0-1]_800:400_um"
        (shape
          (circle "upper_trace" 8000 0 0)
        )
        (shape
          (circle "lower_trace" 8000 0 0)
        )
        (attach off)
      )
    )
    (network_out 
      (net ROUTE
        (wire
          (path "upper_trace" 3000
            260000 -100000
            120000 -100000
          )
        )
      )
      (net KEEP
        (wire
          (path "upper_trace" 3000
            190000 -160000
            210000 -160000
          )
        )
      )
      (net GND
        (wire
          (path "upper_trace" 3000
            260000 -240000
            120000 -240000
          )
        )
      )
    )
  )
)
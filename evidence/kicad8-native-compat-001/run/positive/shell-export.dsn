    )
    (plane GND (polygon B.Cu 0  6000 -13000  24000 -13000  24000 -20000  6000 -20000  6000 -13000))
    (via "Via[0-1]_600:300_um")
    (rule
      (width 200)
      (clearance 200)
      (clearance 50 (type smd_smd))

      (place J2 20000 -10000 front 0 (PN owned_compat_terminal))
      (place J3 10000 -16000 front 0 (PN owned_compat_terminal))
      (place J4 20000 -16000 front 0 (PN owned_compat_terminal))
    )
  )
  (library

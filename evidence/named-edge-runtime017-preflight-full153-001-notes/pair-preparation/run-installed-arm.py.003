"""Source-only draft: explicit one-arm enclosure reusing016 CliJob/queued bridge.

The single shared protocol must freeze both complete runtimes before either
arm. Lead runs016 then017 sequentially, once each; no repair or retry in a pair.
"""
import time,resource
START=time.monotonic()
def cpu():return sum(x.ru_utime+x.ru_stime for x in(resource.getrusage(resource.RUSAGE_SELF),resource.getrusage(resource.RUSAGE_CHILDREN)))
CPU0=cpu()
from pathlib import Path
import argparse,fcntl,hashlib,importlib.util,json,os,stat,sys
ROOT=Path(__file__).resolve().parents[2];sys.path.insert(0,str(ROOT));sys.dont_write_bytecode=True
from autorouter import pipeline as p,floor_route as f,handoff as h,gui,provenance as pv
BASE=Path(__file__).resolve().parent

def require(value,reason):
    if not value:raise p.Rejected(reason)

def selected_tools(tools):
    # All44 module/tool bytes, versions, network and every policy key remain
    # exact. Later evidence-only Git HEAD/provenance metadata is not authority.
    return {key:value for key,value in tools.items()if key not in {'git_head','source_provenance'}}

def python_file_context(path):
    path=pv.canonical(Path(path).absolute());digest,size=pv.file_digest(path,128*1024**2)
    return dict(path=str(path),resolved_path=str(path.resolve(strict=True)),sha256=digest,bytes=size)

def coordinator_python_context():
    return dict(**python_file_context(Path(sys.executable)),version=list(sys.version_info[:3]),implementation=sys.implementation.name)

def child_receipt(receipt,arm,pin):
    if not os.path.lexists(receipt):return None,None,None
    raw=pv.read_bytes(receipt,8*1024**2)
    try:
        row=f.read_json(receipt)
        require(pv.read_bytes(receipt,8*1024**2)==raw,'child receipt changed while parsing')
        require(type(row)is dict and row.get('schema')==1 and row.get('kind')=='installed-named-edge-pair-arm-v1'
            and row.get('arm')==arm and row.get('protocol_sha256')==pin,'child receipt arm/protocol identity differs')
    except Exception as exc:return raw,None,type(exc).__name__+': '+str(exc)
    return raw,row,None

def child_bytes_fresh(receipt,raw):
    current=pv.read_bytes(receipt,8*1024**2)if os.path.lexists(receipt)else None
    require(current==raw,'child receipt raw bytes changed, disappeared or appeared late')

def frozen_pair(protocol,pin):
    plan=f.read_json(protocol)
    require(p.sha(protocol)==pin and plan.get('status')=='frozen' and plan.get('kind')=='adapter-fidelity-installed-pair-v1'
        and list(plan.get('arms',{}))==['016','017'] and plan.get('outer_controller_sha256')==p.sha(Path(__file__)),
        'exact shared frozen pair/controller required; draft is not executable')
    coordinator=p.tool_manifest()
    require(plan['coordinator_tools']is not None and len(coordinator['implementation_sha256'])==44
        and selected_tools(coordinator)==selected_tools(plan['coordinator_tools']),
        'coordinator runtime/tool/version/network/policy context changed')
    coordinator_python=coordinator_python_context()
    require(sys.version_info[:2]==(3,11) and coordinator_python==plan['coordinator_python'],
        'actual regular coordinator Python3.11 bytes/path/version changed')
    require(plan['limits']==dict(child_wall_full_cpu_seconds=238,child_watchdog_seconds=245,outer_wall_full_cpu_seconds=258,external_wall_full_cpu_seconds=260),
        'equal established016 wall/fullCPU envelope required')
    require(plan['expected_protected']==1 and plan['expected_copper_layers']==['F.Cu','B.Cu'] and plan['expected_zones']==0,'fixed owned source support scope required')
    require(p.sha(Path(plan['signal_bridge_controller']))==plan['signal_bridge_sha256'],'queued cancellation bridge changed')
    require(plan['threshold006_result']in plan['prerequisite_sha256'],'actual006 result must be explicitly hash-pinned before either arm')
    for path,digest in plan['prerequisite_sha256'].items():require(p.sha(Path(path))==digest,'frozen prerequisite changed: '+path)
    threshold=f.read_json(Path(plan['threshold006_result']))
    require(threshold.get('passed')is True and threshold.get('status')=='completed' and len(threshold.get('cases',[]))==4
        and threshold.get('accepted')is False and threshold.get('production_admitted')is False,'actual completed four-control006 prerequisite required')
    for arm in plan['arms'].values():
        runtime=Path(arm['runtime']);manifest=runtime/'runtime-distribution.json';child=runtime/'.runs'/plan['installed_child_name']
        require(arm['runtime_tools']is not None and p.sha(manifest)==arm['runtime_manifest_sha256']
            and p.sha(child)==plan['child_sha256'],'both installed manifests/tools/child scripts must freeze before either arm')
        require(arm['python_context']is not None and python_file_context(runtime/'.venv/bin/python')==
            {key:arm['python_context'][key]for key in ('path','resolved_path','sha256','bytes')}
            and arm['python_context']['sha256']==coordinator_python['sha256']
            and arm['python_context']['version']==coordinator_python['version']
            and arm['python_context']['implementation']==coordinator_python['implementation'],
            'both actual regular installed Python3.11 byte/path/version pins must match coordinator')
        distribution=f.read_json(manifest)
        for name,digest in distribution['build_source']['files_sha256'].items():require(p.sha(runtime/name)==digest,'installed distribution file changed: '+name)
        for path,digest in arm['runtime_tools']['files'].items():require(p.sha(Path(path))==digest,'frozen arm tool binary changed: '+path)
        require(arm['runtime_tools']['source_provenance']['manifest_sha256']==arm['runtime_manifest_sha256'],'runtime tool manifest is not bound to distribution')
        require(arm['runtime_tools']['kicad']=='10.0.0' and arm['runtime_tools']['freerouting']=='2.5.0','same pinned Native/engine versions required')
    old,new=(plan['arms'][name]for name in ('016','017'))
    require(coordinator['implementation_sha256']==new['runtime_tools']['implementation_sha256'],
        'coordinator must use the same exact44 qualified modules as017')
    require(sorted(old['runtime_tools']['files'].values())==sorted(new['runtime_tools']['files'].values()),'equal pinned Native/Java/JAR binary bytes required')
    require(old['required_receipt_policy']=={}and new['required_receipt_policy']=={'native_edge_admission_policy':'known-named-whole-native-edge-v1'},
        'explicit observed route receipt policies required; no harness opt-in')
    old_impl,new_impl=old['runtime_tools']['implementation_sha256'],new['runtime_tools']['implementation_sha256']
    changed=sorted(name for name in set(old_impl)|set(new_impl)if old_impl.get(name)!=new_impl.get(name))
    require(changed==plan['reviewed_implementation_changes'],'all installed runtime differences must be reviewed/frozen before either arm')
    return plan

def execute(protocol,pin,arm_name):
    plan=frozen_pair(protocol,pin);arm=plan['arms'][arm_name];runtime=Path(arm['runtime']);child=runtime/'.runs'/plan['installed_child_name']
    if arm_name=='017':require((BASE/'arm016/result.json').is_file(),'freeze/run016 first; retain its failure if any')
    out=BASE/('arm'+arm_name);out.mkdir();owner={};h.capture_destination(owner,out);job=gui.CliJob()
    helper=Path(plan['signal_bridge_controller']);spec=importlib.util.spec_from_file_location('existing_bridge',helper);bridge=importlib.util.module_from_spec(spec);spec.loader.exec_module(bridge)
    fd=os.open(ROOT/'.runs/quality-experiment.lock',os.O_RDWR|os.O_NOFOLLOW)
    with bridge.cancellation_bridge(job)as(queued,live),os.fdopen(fd,'r+')as lane:
        info=os.fstat(lane.fileno());require(stat.S_ISREG(info.st_mode)and info.st_nlink==1,'ordinary shared Native lane required')
        fcntl.flock(lane,fcntl.LOCK_EX|fcntl.LOCK_NB)
        process=job.run([*f.SANDBOX,str(runtime/'.venv/bin/python'),'-B',str(child),'--protocol',str(protocol),'--protocol-sha256',pin,'--arm',arm_name],out/'command.log',timeout=245)
        receipt=runtime/'.runs'/arm['child_output_name']/'result.json';raw=None;row=None;receipt_error=None
        try:raw,row,receipt_error=child_receipt(receipt,arm_name,pin)
        except Exception as exc:receipt_error=type(exc).__name__+': '+str(exc)
        material=f.evidence_inventory(receipt.parent)if receipt.parent.is_dir()else None;logpin=p.sha(out/'command.log')
        passed=bool(row and row.get('passed')is True and row.get('status')=='completed' and row.get('tools')==arm['runtime_tools']
            and process['exit_code']==0 and not process['cancel_requested']and not process['log_truncated'])
        record=dict(schema=1,kind='installed-named-edge-pair-enclosure-v1',accepted=False,passed=passed,status='completed'if passed else'failed',
            arm=arm_name,protocol_sha256=pin,process=process,child=row,scope=plan['scope'],
            coordinator_tools=p.tool_manifest(),coordinator_python=coordinator_python_context(),
            child_receipt=str(receipt),child_receipt_sha256=None if raw is None else hashlib.sha256(raw).hexdigest(),
            child_receipt_bytes=None if raw is None else len(raw),child_receipt_error=receipt_error,
            accounting_point='Inner sample through reaped child/publication; external complete command wall/fullCPU<=260s remains mandatory. No build/research/authoring cost is hidden in this workflow figure.')
        def remaining():return min(258-(time.monotonic()-START),258-(cpu()-CPU0))
        def fresh():
            if record['passed']:live()
            h.owned_destination(owner);frozen_pair(protocol,pin)
            current=f.evidence_inventory(receipt.parent)if receipt.parent.is_dir()else None
            require(current==material and p.sha(out/'command.log')==logpin,'completed installed arm changed')
            # evidence_inventory deliberately excludes root result.json. Bind
            # its exact bytes explicitly after every last material/tool callback.
            child_bytes_fresh(receipt,raw)
            if record['passed']:live()
        def account():
            record.update(inner_sample_wall_seconds=time.monotonic()-START,inner_sample_full_cpu_seconds=cpu()-CPU0)
            if remaining()<=0:record.update(passed=False,status='budget_exceeded')
            if queued[0]or job.cancel_requested:record.update(passed=False,status='cancelled')
            if record['status']!='completed':record['passed']=False
        def final():
            fresh();require(remaining()>0,'whole installed enclosure deadline exhausted')
        try:
            f.publish(out,record,fresh,account,remaining,owned=lambda:h.owned_destination(owner),final_check=final)
            if record['passed']:
                fresh();live();child_bytes_fresh(receipt,raw)
                require(remaining()>0,'whole installed enclosure deadline exhausted after publication')
        except BaseException as exc:
            def failed():raise exc
            f.publish(out,record,failed,account,remaining,owned=lambda:h.owned_destination(owner))
        print(json.dumps({key:record.get(key)for key in('passed','status','inner_sample_wall_seconds','inner_sample_full_cpu_seconds')}))
        return 0 if record['passed']and record['status']=='completed'else 2

if __name__=='__main__':
    if sys.argv[1:]==['--coordinator-metadata']:
        require(sys.version_info[:2]==(3,11),'coordinator Python3.11 metadata required')
        print(json.dumps(dict(coordinator_tools=p.tool_manifest(),coordinator_python=coordinator_python_context()),sort_keys=True));raise SystemExit(0)
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--protocol',type=Path,required=True);parser.add_argument('--protocol-sha256',required=True);parser.add_argument('--arm',choices=('016','017'),required=True);args=parser.parse_args()
    raise SystemExit(execute(args.protocol.resolve(),args.protocol_sha256,args.arm))

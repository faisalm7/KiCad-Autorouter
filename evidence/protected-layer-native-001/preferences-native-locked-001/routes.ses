(session task
  (base_design task)
  (placement
    (resolution um 10)
    (component "diagnostic_terminal"
      (place J1 100000 -100000 front 0)
      (place J4 400000 -200000 front 0)
      (place J3 100000 -200000 front 0)
      (place J5 100000 -300000 front 0)
      (place J6 400000 -300000 front 0)
      (place J2 400000 -100000 front 0)
    )
  )
  (was_is
  )
  (routes 
    (resolution um 10)
    (parser
      (host_cad "KiCad's Pcbnew")
      (host_version "10.0.0")
    )
    (library_out 
      (padstack "Via[0-1]_600:300_um"
        (shape
          (circle F.Cu 6000 0 0)
        )
        (shape
          (circle B.Cu 6000 0 0)
        )
        (attach off)
      )
    )
    (network_out 
      (net "SIGNAL_A"
        (wire
          (path F.Cu 2000
            150000 -100000
            400000 -100000
          )
        )
      )
      (net "SIGNAL_B"
        (wire
          (path F.Cu 2000
            150000 -200000
            400000 -200000
          )
        )
      )
      (net GND
        (wire
          (path F.Cu 2000
            400000 -300000
            100000 -300000
          )
        )
      )
    )
  )
)